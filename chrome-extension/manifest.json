{
  "manifest_version": 3,
  "name": "My Dashboard Bridge",
  "version": "1.0",
  "description": "Dashboard MCP ↔ Claude.ai 브릿지",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dashboard Bridge"
  }
}
