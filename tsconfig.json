{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "//exclude": "electron/와 src/cards 카드그리드 시스템은 현재 App에 연결 안 된 미완성/고아 코드 + 미설치 의존성(electron, react-grid-layout) 참조 — 빌드에서 제외(나중에 되살릴 때 의존성 설치 후 제외 해제)",
  "exclude": ["electron", "src/cards", "src/store/useLayout.ts", "src/types/card.ts", "src/components/AddCardMenu.tsx"]
}
